# Atlas Community public-demo configuration. Copy to `.env` (never commit `.env`).
#
#   cp .env.example .env

# Which image the demo runs. `:latest` tracks the newest released main (watchtower follows it).
ATLAS_COMMUNITY_IMAGE=ghcr.io/vev-software/atlas-community:latest

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel -> Install connector).
# Map the public hostname (e.g. demo.example.com) -> http://atlas:8080 in the dashboard.
# Do NOT put a Cloudflare Access policy on this hostname — the demo is meant to be open.
CLOUDFLARE_TUNNEL_TOKEN=

# How often (seconds) watchtower checks GHCR for a newer image.
WATCHTOWER_POLL_INTERVAL=300

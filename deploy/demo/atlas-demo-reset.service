# Oneshot unit that resets the public Atlas Community demo. Triggered by atlas-demo-reset.timer.
#
# Install (on the Proxmox host / demo VM):
#   sudo cp atlas-demo-reset.service atlas-demo-reset.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now atlas-demo-reset.timer
#   systemctl list-timers atlas-demo-reset.timer      # confirm next run
#
# Adjust COMPOSE_DIR below if you cloned somewhere other than /opt/atlas-community-demo.
[Unit]
Description=Reset the public Atlas Community demo (wipe data, pull latest, restart)
# Engine-agnostic: the reference host runs podman, and `podman compose` needs no daemon, so this must
# NOT hard-require docker.service — Requires=docker.service would make the reset fail to activate on a
# podman-only host and the nightly wipe would silently never run. Order after the network; order after
# docker.service too, but only if that unit exists (a bare After= on an absent unit is ignored).
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=COMPOSE_DIR=/opt/atlas-community-demo/deploy/demo
ExecStart=/opt/atlas-community-demo/deploy/demo/reset-demo.sh

<?xml version="1.0" encoding="utf-8"?>
<!--
  Atlas Community is a PUBLIC repo (AGPL-3.0). It may depend only on PUBLIC feeds
  (AGENTS.md §1.9). atlas-contracts is public Apache-2.0, published to nuget.org.

  The `local-atlas-contracts` source below points at a sibling build output so the
  two repos can be iterated together before atlas-contracts is published to nuget.org.
  It contains only the PUBLIC Apache-2.0 contracts package — no private feed — so the
  public-build rule holds. Remove it once atlas-contracts is on nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-atlas-contracts" value="../.local-nuget" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <!-- The public contracts package comes from the sibling build; everything else from nuget.org. -->
    <packageSource key="local-atlas-contracts">
      <package pattern="Vev.Atlas.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

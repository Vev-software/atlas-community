<?xml version="1.0" encoding="utf-8"?>
<!--
  Atlas Community is a PUBLIC repo (AGPL-3.0). It may depend only on PUBLIC feeds
  (AGENTS.md §1.9). atlas-contracts is public Apache-2.0 and is consumed from nuget.org.
  
  NOTE: During development with unreleased atlas-contracts versions, the workspace
  .local-nuget folder serves as a supplementary feed before nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../.local-nuget/Vev.Atlas.Contracts/0.1.1/" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Overrides the machine-level packageSourceMapping (%APPDATA%\NuGet\NuGet.Config), which
       routes "*" through nuget.org only and would otherwise silently exclude "local". -->
  <packageSourceMapping>
    <clear />
    <packageSource key="local">
      <package pattern="Vev.Atlas.Contracts" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

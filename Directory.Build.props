<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Atlas Community Edition is PUBLIC, AGPL-3.0 (recorded via ADR, handbook 02 §4). -->
    <Company>VEV Software ApS</Company>
    <Product>Atlas</Product>
    <Authors>VEV Software ApS</Authors>
    <RepositoryUrl>https://github.com/Vev-software/Atlas</RepositoryUrl>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>
</Project>
